  async inventory(id) {
    const project = this.project(id), state = this.state(id)
    const scans = await Promise.all(project.sources.map((source) => scanSource(source, this.config)))
    // 2 October 2026, 15:40 CEST: an active copy supplies working bytes while canonical Memory stays on its original source.
    const byId = new Map(scans.flatMap((scan) => scan.files).map((file) => [file.id, file]))
