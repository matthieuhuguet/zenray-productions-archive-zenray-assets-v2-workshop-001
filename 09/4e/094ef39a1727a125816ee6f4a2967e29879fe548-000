    if (action === 'preview-text') {
      const file = this.state(id).inventory?.localFiles.find((entry) => entry.id === payload.fileId)
      if (!file || !isTextPreviewFile(file.relativePath)) throw new Error('Local text preview unavailable')
      const source = this.project(id).sources.find((entry) => entry.id === file.sourceId)
      const actual = await realpath(file.localPath)
      if (actual !== file.localPath || !isInside(file.workingRoot || source.localPath, actual)) throw new Error('Unsafe preview path')
      const descriptor = await open(actual, constants.O_RDONLY | constants.O_NOFOLLOW)
      try {
        const before = await descriptor.stat()
        if (!before.isFile()) throw new Error('Preview requires a regular file')
        const buffer = Buffer.alloc(Math.min(before.size, PROJECT_PREVIEW_CONFIG.textMaxBytes))
        const { bytesRead } = await descriptor.read(buffer, 0, buffer.length, 0)
        const after = await descriptor.stat()
        if (changeToken(before) !== changeToken(after)) throw new Error('Preview file changed during reading; retry')
        if (buffer.subarray(0, bytesRead).includes(0)) throw new Error('Binary content has no text preview')
        return { text: buffer.subarray(0, bytesRead).toString('utf8'), size: before.size, truncated: bytesRead < before.size, checkedAt: new Date().toISOString() }
      } finally { await descriptor.close() }
    }
    if (action === 'preview-url') {
      const file = this.state(id).inventory?.localFiles.find((entry) => entry.id === payload.fileId)
      if (!file || !/\.(png|jpe?g|webp|avif|gif)$/i.test(file.relativePath)) throw new Error('Local image preview unavailable')
      const expires = Date.now() + 600000
      const token = createHmac('sha256', this.previewSecret).update(`${id}:${file.id}:${expires}`).digest('hex')
      return { url: `http://127.0.0.1:${this.config.bridge.port}/api/assets-workspace-preview?projectId=${encodeURIComponent(id)}&fileId=${encodeURIComponent(file.id)}&expires=${expires}&token=${token}` }
    }
    if (action === 'bind-session') {
      this.project(id)
      if (typeof payload.sessionId !== 'string' || !/^[a-zA-Z0-9-]{8,128}$/.test(payload.sessionId)) throw new Error('Valid host session id required')
      const file = path.join(this.config.storage.stateDir, 'SessionBindings.json')
      // 2 October 2026: simultaneous project sessions must not lose each other's feedback binding.
      const bindingLock = await acquireDirectoryLock(path.join(this.config.storage.stateDir, 'session-bindings.lock'), directoryLockOptions('court', 'Assets session bindings'))
      try {
        let bindings = {}
        try { bindings = JSON.parse(await readFile(file, 'utf8')) } catch (error) { if (error.code !== 'ENOENT') throw error }
        // 3 October 2026, 21:53 CEST: reject reassignment under the shared lock before writing or replaying any history.
        if (bindings[payload.sessionId] && bindings[payload.sessionId] !== id) throw new Error('Session is already bound to a different project; existing history is preserved')
        await atomicJson(file, { ...bindings, [payload.sessionId]: id })
      } finally { await bindingLock.release() }
      await this.feedbackCapture?.replay(payload.sessionId)
      return { projectId: id, sessionId: payload.sessionId, checkedAt: new Date().toISOString() }
    }
    if (action === 'start') {
      const projectId = String(payload.id || '')
      // 3 October 2026, 03:32 CEST: linked sources use the same complete initialization as an empty workshop.
      const supplied = payload.project ? this.validateProject(payload.project) : null
      if (supplied && supplied.id !== projectId) throw new Error('Project definition does not match its initialization identity')
      if (payload.sessionId !== undefined && (typeof payload.sessionId !== 'string' || !/^[a-zA-Z0-9-]{8,128}$/.test(payload.sessionId))) throw new Error('Valid host session id required')
      const temporary = path.join(this.config.roots.tmp, `tmp-${projectId}`)
      const notes = path.join(this.config.roots.memory, 'Projects', projectId)
      const base = this.validateProject({ id: projectId, name: payload.name || this.projects.get(projectId)?.name, category: payload.category || 'Projet',
        feedbackPath: path.join(notes, 'FEEDBACK.md'), sources: [
          { id: 'workshop', namespace: 'tmp', localPath: temporary },
          { id: 'project-notes', namespace: 'memory', localPath: notes, keep: true },
        ] })
      // 2 October 2026: repeatable initialization preserves linked production sources and existing documents.
      const lock = await acquireDirectoryLock(path.join(this.config.storage.stateDir, `start-${projectId}.lock`), directoryLockOptions('court', 'Assets project initialization'))
      try {
        const previous = this.projects.get(projectId)
        const sources = [...(previous?.sources || [])]
        for (const source of supplied?.sources || []) {
          const position = sources.findIndex((entry) => entry.id === source.id)
          if (position < 0) sources.push(source); else sources[position] = source
        }
        for (const source of base.sources) {
          const exists = source.namespace === 'tmp' ? sources.some((entry) => entry.namespace === 'tmp') : sources.some((entry) => entry.namespace === 'memory' && entry.localPath === notes)
          if (!exists) {
            let sourceId = source.id
            while (sources.some((entry) => entry.id === sourceId)) sourceId += '-canonical'
            sources.push({ ...source, id: sourceId })
          }
        }
        const definition = this.validateProject({ ...base, ...previous, ...supplied, feedbackPath: base.feedbackPath, sources })
        const sourceWorkshopPath = sources.find((source) => source.namespace === 'tmp').localPath
        const active = this.states.get(projectId)?.workspacePath || null
        if (active && (path.dirname(active) !== path.join(this.config.storage.workspaceDir, projectId, 'loads') || await realpath(active) !== active)) throw new Error('Unsafe active workspace')
        const workshop = projectWorkshopPath({ ...definition, workspace: { state: active ? 'loaded' : 'unloaded', path: active } })
        for (const directory of [workshop, notes]) {
          let parent = directory
          while (true) {
            try { if (await realpath(parent) !== parent) throw new Error('Project directory contains a symlink'); break }
            catch (error) { if (error.code !== 'ENOENT') throw error; parent = path.dirname(parent) }
          }
          await mkdir(directory, { recursive: true })
          if (await realpath(directory) !== directory) throw new Error('Unsafe project directory')
        }
        let createdAt = new Date().toISOString()
        try {
          const existing = JSON.parse(await readFile(path.join(notes, 'Project.json'), 'utf8'))
          if (existing.projectId !== projectId) throw new Error('Project memory belongs to another project')
          createdAt = existing.createdAt || createdAt
        } catch (error) { if (error.code !== 'ENOENT') throw error }
        try { const feedback = await lstat(definition.feedbackPath); if (!feedback.isFile() || feedback.isSymbolicLink()) throw new Error('Canonical feedback must be a regular file') }
        catch (error) { if (error.code !== 'ENOENT') throw error }
        const metadata = { schemaVersion: this.config.schemaVersion, projectId, workshopPath: workshop, sourceWorkshopPath, memoryPath: notes, memoryFile: path.join(notes, 'Project1.md'), feedbackPath: definition.feedbackPath, cloudFolder: definition.folder, createdAt }
        await atomicJson(path.join(notes, 'Project.json'), metadata)
        const documentDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'Europe/Paris' }).format(new Date())
        const instructions = `# Project workspace (${documentDate})\n\n- Project ID: ${projectId}. (${documentDate})\n- Read the global doctrine at /Users/zenray/.claude/CLAUDE.md and use the zenray-assets-v2 skill. (${documentDate})\n- Read canonical feedback: ${definition.feedbackPath}. Append through feedback-stack; never rewrite prior entries. (${documentDate})\n- Work in ${workshop}; keep durable knowledge in ${notes}. Linked production directories remain in place. (${documentDate})\n- Assets watches registered sources automatically. A local entry is not proof of verified cloud backup. (${documentDate})\n`
        for (const filename of ['CLAUDE.md', 'AGENTS.md']) {
          try { await writeFile(path.join(workshop, filename), instructions, { flag: 'wx', mode: 0o600 }) }
          catch (error) { if (error.code !== 'EEXIST') throw error }
        }
        try { await writeFile(metadata.memoryFile, `# ${definition.name} : project knowledge (${documentDate})\n\n- Project ID: ${projectId}. (${documentDate})\n- Canonical feedback: ${definition.feedbackPath}. (${documentDate})\n- Append dated decisions and verified knowledge here; retain existing entries. (${documentDate})\n`, { flag: 'wx', mode: 0o600 }) }
        catch (error) { if (error.code !== 'EEXIST') throw error }
        await execFileAsync('python3', [this.config.storage.feedbackWriter, 'add', projectId, `Project initialized: ${definition.name}. Workshop: ${workshop}.`, '--file', definition.feedbackPath, '--kind', 'log', '--event-id', `project-created:${projectId}`, '--json'])
        await this.register(definition)
        if (payload.sessionId) await this.request('bind-session', { projectId, sessionId: payload.sessionId })
        const project = await this.setWatch(projectId, true)
        return { project, setup: { ...metadata, sessionBound: !!payload.sessionId, watched: true }, checkedAt: new Date().toISOString() }
      } finally { await lock.release() }
    }
    // 3 October 2026, 15:14 CEST: agents without readable native transcripts can commit an explicitly labeled turn checkpoint.
    if (action === 'checkpoint') {
      const project = this.project(id)
      if (!['codex', 'claude', 'gemini', 'antigravity'].includes(payload.agent) || typeof payload.sessionId !== 'string' || !/^[a-zA-Z0-9_-]+$/.test(payload.sessionId) || typeof payload.checkpointId !== 'string' || !/^[a-zA-Z0-9_.-]+$/.test(payload.checkpointId) || typeof payload.summary !== 'string' || !payload.summary.trim()) throw new Error('Agent, real session identity, checkpoint identity and summary required')
      let bindings = {}
      try { bindings = JSON.parse(await readFile(path.join(this.config.storage.stateDir, 'SessionBindings.json'), 'utf8')) } catch (error) { if (error.code !== 'ENOENT') throw error }
      if (bindings[payload.sessionId] && bindings[payload.sessionId] !== id) throw new Error('Session belongs to a different project; begin the correct project before committing')
      const feedback = await lstat(project.feedbackPath)
      if (!feedback.isFile() || feedback.isSymbolicLink() || await realpath(project.feedbackPath) !== project.feedbackPath) throw new Error('Canonical feedback is unsafe')
      const eventId = `checkpoint:${id}:${payload.agent}:${payload.sessionId}:${payload.checkpointId}`
      const result = await execFileAsync('python3', [this.config.storage.feedbackWriter, 'add', id, payload.summary, '--file', project.feedbackPath, '--kind', 'iteration', '--event-id', eventId, '--source', `checkpoint:${payload.agent}:${payload.sessionId}`, '--json'])
      await this.inventory(id)
      this.scheduleBackup(id)
      return { checkpoint: { ...JSON.parse(result.stdout), eventId, backupConfirmed: false }, checkedAt: new Date().toISOString() }
    }
    if (action === 'history') {
      const project = this.project(id)
      const events = await readProjectHistory(project, this.state(id).inventory?.localFiles || [], this.events.filter((event) => event.projectId === id), {
        progressPath: this.config.storage.progressPath,
      })
      return { events, feedbackPath: project.feedbackPath, checkedAt: new Date().toISOString() }
    }
    if (action === 'publish') {
      if (!this.cloudPublisher) throw new Error('Cloud publisher unavailable')
      await this.publishProject(id)
      return { project: this.snapshot(id), checkedAt: new Date().toISOString() }
    }
    if (action === 'register') return { project: await this.register(payload.project), checkedAt: new Date().toISOString() }
    if (action === 'list' || action === 'status' && !id) {
      for (const projectId of this.projects.keys()) if (!this.state(projectId).inventory) await this.inventory(projectId)
      return { schemaVersion: this.config.schemaVersion, checkedAt: new Date().toISOString(), bridge: { connected: true, state: 'connected' },
        projects: [...this.projects.keys()].map((projectId) => this.snapshot(projectId)), events: this.events }
    }
    if (action === 'inventory') return { project: await this.inventory(id), checkedAt: new Date().toISOString() }
    // 3 October 2026, 03:44 CEST: Finder opens the verified project workshop, never a path supplied by the client.
    if (action === 'open-workshop') {
      const project = await this.inventory(id)
      const directory = projectWorkshopPath(project)
      if (!directory || !(await lstat(directory)).isDirectory() || await realpath(directory) !== directory) throw new Error('Project workshop unavailable or unsafe')
      await this.openDirectory(directory)
