        try { await lstat(workingPath) } catch (error) { if (error.code === 'ENOENT') continue; throw error }
        const scan = await scanSource({ ...source, localPath: workingPath }, { ...this.config, roots: { ...this.config.roots, [source.namespace]: root } })
