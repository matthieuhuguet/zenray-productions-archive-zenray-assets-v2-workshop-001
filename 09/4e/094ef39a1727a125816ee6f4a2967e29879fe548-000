      excluded: scans.reduce((count, scan) => count + scan.excluded.length, 0), issues: scans.flatMap((scan) => scan.issues) }
    await this.save(id)
    await this.refreshContextIndex()
    this.scheduleSceneAudits(id)
    return this.snapshot(id)
  }

  // 2 October 2026: one derived mapping index stays current without duplicating authoritative project definitions.
  refreshContextIndex() {
    const task = this.contextIndexQueue.catch(() => {}).then(async () => {
      const index = buildGlobalProjectIndex([...this.projects.keys()].map((id) => this.snapshot(id)))
