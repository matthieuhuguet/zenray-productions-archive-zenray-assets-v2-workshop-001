  // 3 October 2026, 04:46 CEST: machine diagnostics use source identities while authored feedback keeps its original text.
  cloudDiagnostic(id, value) {
    if (typeof value !== 'string') return value
    const aliases = [
      ...this.project(id).sources.map((source) => [source.localPath, `[source:${source.id}]`]),
      ...Object.entries(this.config.roots).map(([namespace, root]) => [root, `[${namespace}]`]),
      [this.config.storage.stateDir, '[local-state]'], [this.config.storage.workspaceDir, '[workspace]'],
      [this.repoRoot, '[application]'], [process.env.HOME, '[home]'],
      ['/Applications', '[applications]'], ['/private/var', '[temporary]'], ['/var/folders', '[temporary]'], ['/tmp', '[temporary]'], ['/Volumes', '[volume]'],
    ].filter(([root]) => typeof root === 'string' && root.length > 1).sort(([left], [right]) => right.length - left.length)
