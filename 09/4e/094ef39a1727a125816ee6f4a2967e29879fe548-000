              const copySha256 = await checkedHash(file)
              if (copySha256 !== originalSha256) {
                const previous = state.inventory?.localFiles.find((entry) => entry.id === file.id)?.sourceConflict
                sourceConflict = { originalPath: original.localPath, originalChangeToken: original.changeToken, originalSha256, originalSize: original.size, copySha256, reason: baseline?.sha256 ? 'original-changed' : 'baseline-missing',
                  detectedAt: previous?.originalSha256 === originalSha256 && previous?.copySha256 === copySha256 ? previous.detectedAt : new Date().toISOString() }
              }
            }
          }
