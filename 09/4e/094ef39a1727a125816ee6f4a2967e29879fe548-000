  // 3 October 2026, 04:15 CEST: scene references derive from current inventories, including their declared shared libraries.
  sceneReferenceContexts(id) {
    const audits = Object.entries(this.state(id).sceneAudits || {})
    if (!audits.length) return []
    const projects = [...this.projects.values()].map((project) => ({ ...project,
      files: combineWorkspaceFiles(project, this.state(project.id).inventory?.localFiles || [], this.state(project.id).backups, this.state(project.id).restorations)
        // 3 October 2026, 05:00 CEST: preserve declared source identity separately from the active copy's actual read path.
        .map((file) => ({ ...file, canonicalPath: file.present ? file.localPath : null,
          originCanonicalPath: file.loadedCopy ? path.join(project.sources.find((source) => source.id === file.sourceId).localPath, file.relativePath) : null })) }))
    return audits.map(([sceneFileId, entry]) => {
      const file = this.state(id).inventory?.localFiles.find((candidate) => candidate.id === sceneFileId)
      const preparation = this.scenePreparationEvidence(id, sceneFileId, projects)
      if (!file || file.changeToken !== entry.changeToken) return { sceneFileId, sceneSha256: entry.audit.sceneSha256, state: 'stale', references: [], ...(preparation ? { preparation: { ...preparation, state: 'stale' } } : {}), portabilityVerified: false }
      return { ...mapSceneReferences({ projectId: id, sceneFileId, sceneSha256: entry.audit.sceneSha256, audit: entry.audit, projects }), state: 'current', ...(preparation ? { preparation } : {}) }
    })
  }

  // 3 October 2026, 09:08 CEST: export a narrow historical proof; current copy paths and hashes determine whether it is still applicable.
  scenePreparationEvidence(id, sceneFileId, projects) {
    const proof = this.state(id).scenePreparations?.[sceneFileId]
    if (!proof) return null
    const files = new Map(projects.flatMap((project) => (project.files || []).map((file) => [`${project.id}/${file.id}`, file])))
    const current = [{ projectId: id, fileId: sceneFileId, targetPath: proof.plan.scenePath, sha256: proof.plan.sceneSha256 }, ...proof.plan.resources]
      .every((target) => { const file = files.get(`${target.projectId}/${target.fileId}`); return file?.present && file.loadedCopy && file.localPath === target.targetPath && file.sha256 === target.sha256 })
    return { state: current ? 'verified' : 'stale', checkedAt: proof.report.checkedAt, sceneSha256: proof.report.sceneSha256,
      sceneOpened: proof.report.sceneOpened, resourceCount: proof.report.resourceBytesVerified,
      inputCount: proof.report.reboundInputs.length, libraryCount: proof.report.loadedLibraries.length,
      instanceCount: proof.report.loadedLibraries.reduce((count, library) => count + library.instancePaths.length, 0),
      unresolvedReferenceCount: proof.plan.unresolvedReferences.length, warningCount: proof.report.warnings?.length || 0,
      diagnosticCount: String(proof.report.processDiagnostics || '').split('\n').filter((line) => line.trim()).length,
      resourceVersions: proof.plan.resources.map(({ projectId, fileId, sha256 }) => ({ projectId, fileId, sha256 })),
