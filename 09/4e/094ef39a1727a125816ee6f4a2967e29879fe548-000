  async initialize() {
    await mkdir(this.config.storage.stateDir, { recursive: true })
    try { this.events = (await readFile(path.join(this.config.storage.stateDir, 'Events.jsonl'), 'utf8')).split('\n').filter(Boolean).map((line) => JSON.parse(line)).slice(-this.config.storage.maxEvents) }
    catch (error) { if (error.code !== 'ENOENT') throw new Error('Project history is unreadable; original events retained') }
    const definitions = [...this.config.projects]
    try {
      const registry = JSON.parse(await readFile(path.join(this.config.storage.stateDir, 'Projects.json'), 'utf8'))
      for (const project of registry.projects || []) {
        const position = definitions.findIndex((entry) => entry.id === project.id)
        if (position < 0) definitions.push(project); else definitions[position] = project
      }
    } catch (error) { if (error.code !== 'ENOENT') throw new Error('Runtime project registry is unreadable') }
    for (const definition of definitions) {
      const project = this.validateProject(definition)
      this.projects.set(project.id, project)
      let state = { backups: {}, restorations: {}, watched: false, jobs: [] }
      try { state = { ...state, ...JSON.parse(await readFile(this.statePath(project.id), 'utf8')) } }
      catch (error) { if (error.code !== 'ENOENT') state.error = 'Saved project status is unreadable; inventory required' }
      if (['queued', 'running', 'restoring'].includes(state.syncState)) {
        state.syncState = 'interrupted'; state.error = 'Previous service stopped before completion; backup can resume'
      }
      // 2 October 2026, 15:10 CEST: reconcile an interrupted release without deleting anything at startup.
      for (const release of state.releases || []) {
        if (!['prepared', 'removing', 'interrupted'].includes(release.phase)) continue
        try { await lstat(release.activePath) }
        catch (error) { if (error.code !== 'ENOENT') throw error; if (state.workspacePath === release.activePath) state.workspacePath = null }
      }
      this.states.set(project.id, state)
    }
    return this
  }

  validateProject(definition) {
    const project = normalizeWorkspaceProject(definition, this.config.storage)
    for (const source of project.sources) validateSourceScope(source, this.config)
