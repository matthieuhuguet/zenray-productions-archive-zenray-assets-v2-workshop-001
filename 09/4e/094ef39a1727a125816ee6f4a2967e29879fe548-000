export async function atomicJson(file, value) {
  await mkdir(path.dirname(file), { recursive: true })
  const temporary = `${file}.${process.pid}.${randomUUID()}.tmp`
  await writeFile(temporary, JSON.stringify(value, null, 2), { mode: 0o600 })
  await rename(temporary, file)
}

export function validateSourceScope(source, config) {
  const target = path.resolve(source.localPath)
  // 3 October 2026, 04:03 CEST: explicit library roots extend a source family without granting access to their parent folders.
  const roots = [config.roots[source.namespace], ...(config.additionalRoots?.[source.namespace] || [])].map((root) => path.resolve(root))
  const root = roots.filter((entry) => isInside(entry, target)).sort((a, b) => b.length - a.length)[0]
  if (!root) throw new Error(`Source outside configured ${source.namespace} root`)
  if (target === root && !source.include?.length) throw new Error('A whole source root requires an explicit include list')
  const protectedParts = new Set(config.scan.blockedSegments.map((entry) => entry.toLowerCase()))
  const check = (value) => {
    if (value.split(path.sep).some((entry) => protectedParts.has(entry.toLowerCase()) || /^\.env(?:\.|$)/i.test(entry))) {
      throw new Error('Sensitive source path refused')
    }
  }
  check(target)
  for (const include of source.include || []) check(include)
  return target
}

export function isExcludedSourcePath(relativePath, source, config) {
  const parts = relativePath.split('/')
  const names = new Set([...config.scan.excludedNames, ...config.scan.blockedSegments].map((name) => name.toLowerCase()))
  if (parts.some((name) => names.has(name.toLowerCase()) || /^\.env(?:\.|$)/i.test(name) || name.startsWith('._'))) return true
  if (!config.scan.includeHidden && parts.some((name) => name.startsWith('.'))) return true
  if (config.scan.excludedExtensions.some((ext) => relativePath.toLowerCase().endsWith(ext))) return true
  return [...config.scan.excludedPaths, ...(source.exclude || [])].some((exclude) => {
    const relative = relativePath.toLowerCase()
    const scope = exclude.toLowerCase()
    return relative === scope || relative.startsWith(`${scope}/`) || relative.includes(`/${scope}/`)
  })
}

export async function scanSource(source, config) {
  const root = validateSourceScope(source, config)
  const files = [], issues = [], excluded = []
  let checkedRoot
  try {
    const entry = await lstat(root)
    checkedRoot = await realpath(root)
    if (entry.isSymbolicLink() || checkedRoot !== root || !entry.isDirectory()) throw new Error('Source root must be a real directory without symlink ancestors')
  } catch (error) {
    return { source: { ...source, present: false, count: 0, bytes: 0, status: error.code === 'ENOENT' ? 'missing' : 'error',
      checkedAt: new Date().toISOString() }, files, excluded,
      issues: source.optional && error.code === 'ENOENT' ? [] : [{ sourceId: source.id, code: error.code || 'unsafe-root', message: errorText(error) }] }
  }
  const destinations = new Set()
  const visit = async (directory, prefix = '') => {
    let entries
    try { entries = await readdir(directory, { withFileTypes: true }) }
    catch (error) { issues.push({ sourceId: source.id, relativePath: prefix, code: error.code, message: errorText(error) }); return }
    for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
      const rawRelative = prefix ? `${prefix}/${entry.name}` : entry.name
      if (isExcludedSourcePath(rawRelative, source, config)) { excluded.push(rawRelative); continue }
      const absolute = path.join(directory, entry.name)
      if (entry.isSymbolicLink()) { excluded.push(rawRelative); issues.push({ sourceId: source.id, relativePath: rawRelative, code: 'symlink-skipped' }); continue }
      if (entry.isDirectory()) {
        if (!source.include || source.include.some((include) => include === rawRelative || include.startsWith(`${rawRelative}/`) || rawRelative.startsWith(`${include}/`))) {
          await visit(absolute, rawRelative)
        }
        continue
      }
      if (!entry.isFile() || !pathIsSelected(rawRelative, source.include)) continue
      if (files.length >= config.scan.maxFiles) throw new Error('Inventory limit exceeded; incomplete inventory refused')
      let relativePath
      try { relativePath = safeRelativePath(rawRelative) }
      catch { issues.push({ sourceId: source.id, relativePath: rawRelative, code: 'invalid-path' }); continue }
      const collisionKey = relativePath.toLowerCase()
      if (destinations.has(collisionKey)) throw new Error(`Case or Unicode filename collision in ${source.id}: ${relativePath}`)
      destinations.add(collisionKey)
      try {
        const metadata = await lstat(absolute)
        if (!metadata.isFile() || metadata.isSymbolicLink()) throw new Error('File changed type during scan')
        files.push({ id: workspaceFileId(source.id, relativePath), sourceId: source.id, relativePath,
          localPath: absolute, size: metadata.size, mtimeMs: metadata.mtimeMs, ctimeMs: metadata.ctimeMs,
          changeToken: changeToken(metadata) })
      } catch (error) { issues.push({ sourceId: source.id, relativePath, code: error.code || 'scan-failed', message: errorText(error) }) }
    }
  }
  await visit(root)
  return { source: { ...source, present: true, status: issues.some((issue) => issue.code !== 'symlink-skipped') ? 'error' : 'present',
    count: files.length, bytes: files.reduce((sum, file) => sum + file.size, 0), checkedAt: new Date().toISOString() }, files, excluded, issues }
}

export async function snapshotSourceFile(file, destination, sourceRoot) {
  const actual = await realpath(file.localPath)
  if (actual !== file.localPath || !isInside(path.resolve(sourceRoot), actual)) throw new Error('Source escaped its declared root')
  const descriptor = await open(file.localPath, constants.O_RDONLY | constants.O_NOFOLLOW)
  try {
    const before = await descriptor.stat()
    if (!before.isFile() || changeToken(before) !== file.changeToken) throw new Error('Source changed since inventory')
    await mkdir(path.dirname(destination), { recursive: true })
    const hash = createHash('sha256')
    const hashing = new Transform({ transform(chunk, _encoding, callback) { hash.update(chunk); callback(null, chunk) } })
    await pipeline(descriptor.createReadStream({ autoClose: false }), hashing, createWriteStream(destination, { flags: 'wx', mode: before.mode & 0o777 }))
    if (changeToken(await descriptor.stat()) !== file.changeToken) throw new Error('Source changed during snapshot')
    return { ...file, sha256: hash.digest('hex') }
  } catch (error) { await rm(destination, { force: true }); throw error }
  finally { await descriptor.close() }
}

export async function hashLocalFile(file, expectedToken = null) {
  const hash = createHash('sha256')
  if (!expectedToken) {
    for await (const chunk of createReadStream(file)) hash.update(chunk)
    return hash.digest('hex')
  }
  // 3 October 2026, 10:09 CEST: a version comparison hashes the inventoried descriptor, never a substituted path.
  const descriptor = await open(file, constants.O_RDONLY | constants.O_NOFOLLOW)
  try {
    const before = await descriptor.stat()
    if (!before.isFile() || changeToken(before) !== expectedToken) throw new Error('Source changed before version comparison')
    for await (const chunk of descriptor.createReadStream({ autoClose: false })) hash.update(chunk)
    if (changeToken(await descriptor.stat()) !== expectedToken) throw new Error('Source changed during version comparison')
    return hash.digest('hex')
  } finally { await descriptor.close() }
}

export function batchWorkspaceFiles(files, config) {
  const batches = []
  let current = [], bytes = 0
  for (const file of files) {
    if (current.length && (current.length >= config.storage.batchFiles || bytes + file.size > config.storage.batchBytes)) {
      batches.push(current); current = []; bytes = 0
    }
    current.push(file); bytes += file.size
  }
  if (current.length) batches.push(current)
  return batches
}

export async function runAssetProcess(script, args, { env = process.env, onEvent = () => {}, signal, cwd = REPO_ROOT } = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(process.execPath, [script, ...args], { cwd, env, stdio: ['ignore', 'pipe', 'pipe'], signal })
    let buffered = '', last = '', lastEvent = null
    const line = (value) => {
      if (!value.startsWith('{"zr":')) return
      try { const event = JSON.parse(value); lastEvent = event; onEvent(event) } catch {}
    }
    child.stdout.on('data', (data) => {
      buffered += data
      let index
      while ((index = buffered.indexOf('\n')) >= 0) { line(buffered.slice(0, index)); buffered = buffered.slice(index + 1) }
    })
    child.stderr.on('data', (data) => { last = (last + errorText(data)).slice(-1600) })
    child.once('error', reject)
    child.once('close', (code) => {
      if (buffered) line(buffered)
      if (code !== 0) reject(new Error(`Asset engine failed (${code}): ${last.trim() || 'see engine logs'}`))
      else resolve({ code, lastEvent })
    })
  })
}

