// 7 October 2026: read-only replica of AssetsFeedbackCapture.files() walk (lines 42-54) to time one 5 s pass.
import { readdir, stat, readFile } from 'node:fs/promises'
import path from 'node:path'
const home = process.env.HOME
const cursors = JSON.parse(await readFile(new URL('./state/TranscriptCursors.json', import.meta.url), 'utf8'))
const roots = [path.join(home, '.codex/sessions'), path.join(home, '.claude/projects')]
let readdirs = 0, stats = 0
const files = async (directory, found = []) => {
  let entries; try { entries = await readdir(directory, { withFileTypes: true }); readdirs++ } catch (e) { if (e.code === 'ENOENT') return found; throw e }
  for (const entry of entries) { const filename = path.join(directory, entry.name)
    if (entry.isDirectory()) await files(filename, found)
    else if (entry.isFile() && entry.name.endsWith('.jsonl')) { const info = await stat(filename); stats++; if (info.mtimeMs >= Date.now() - 86400000 || cursors[filename]) found.push({ filename, info }) } }
  return found }
const times = []; let c
for (let i = 0; i < 10; i++) { readdirs = stats = 0; const t = performance.now(); c = (await Promise.all(roots.map(r => files(r)))).flat(); times.push(performance.now() - t) }
const changed = c.filter(({ filename, info }) => !cursors[filename] || cursors[filename].offset !== info.size)
const unboundZero = Object.values(cursors).filter(x => x.offset === 0).length
console.log('walk ms x10', times.map(x => x.toFixed(0)).join(','), 'readdir', readdirs, 'stat', stats, 'candidates', c.length, 'with pending bytes', changed.length, 'cursor entries', Object.keys(cursors).length, 'cursors at offset 0 (unbound, re-matched every pass)', unboundZero, 'subagent candidates', c.filter(x => x.filename.includes('/subagents/')).length)
