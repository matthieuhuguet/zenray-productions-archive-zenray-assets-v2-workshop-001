// 7 October 2026: read-only sampler of state file rewrites (stat only).
import { stat, readdir } from 'node:fs/promises'
import path from 'node:path'
const dir = '/Users/zenray/Library/Application Support/ZenRayAssets'
const seconds = Number(process.argv[2] || 120)
const last = new Map(), counts = new Map(), bytes = new Map()
const watchList = async () => { const top = (await readdir(dir)).filter(n => /\.(json|jsonl)$/.test(n)).map(n => path.join(dir, n)); const ctx = (await readdir(path.join(dir,'contexts'))).map(n => path.join(dir,'contexts',n)); return [...top, ...ctx] }
const t0 = Date.now()
while (Date.now() - t0 < seconds * 1000) {
  for (const f of await watchList()) {
    try { const s = await stat(f); const k = s.mtimeMs + ':' + s.size; const prev = last.get(f); if (prev && prev !== k) { counts.set(f, (counts.get(f)||0)+1); bytes.set(f, (bytes.get(f)||0)+s.size) } last.set(f, k) } catch {}
  }
  await new Promise(r => setTimeout(r, 200))
}
const rows = [...counts].map(([f,c]) => [path.relative(dir,f), c, (bytes.get(f)/1e6).toFixed(1)+' MB']).sort((a,b)=>b[1]-a[1])
console.log(JSON.stringify({ seconds, rows, totalMB: ([...bytes.values()].reduce((a,b)=>a+b,0)/1e6).toFixed(1) }, null, 1))
