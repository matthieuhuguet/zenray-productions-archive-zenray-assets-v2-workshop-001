// 7 October 2026: split snapshot() cost into combineWorkspaceFiles, sceneReferenceContexts, buildProjectMapping.
import { readFileSync } from 'node:fs'
import path from 'node:path'
const repo = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'
const { AssetsService } = await import(repo + '/scripts/AssetsService.mjs')
const { combineWorkspaceFiles } = await import(repo + '/src/lib/projectWorkspace.js')
const { buildProjectMapping } = await import(repo + '/src/lib/projectContextIndex.js')
const config = JSON.parse(readFileSync(repo + '/scripts/AssetsConfig.json', 'utf8'))
config.storage.stateDir = path.resolve('statecopy'); if (config.sceneAudit) config.sceneAudit.enabled = false
const svc = await new AssetsService(config, { getToken: async () => null }).initialize()
const ms = (fn) => { const a = performance.now(); const v = fn(); return [performance.now() - a, v] }
let tc = 0, ts = 0, tm = 0, rows = []
for (const id of svc.projects.keys()) {
  const st = svc.state(id), p = svc.project(id)
  const [c, files] = ms(() => combineWorkspaceFiles(p, st.inventory?.localFiles || [], st.backups, st.restorations))
  const [s] = ms(() => svc.sceneReferenceContexts(id))
  const snap = svc.snapshot(id)
  const [m] = ms(() => buildProjectMapping(snap))
  tc += c; ts += s; tm += m
  rows.push([id.slice(0, 30), files.length, Object.keys(st.sceneAudits || {}).length, c.toFixed(0), s.toFixed(0), m.toFixed(0)])
}
console.table(rows); console.log({ combineTotal: tc.toFixed(0), sceneRefsTotal: ts.toFixed(0), mappingTotal: tm.toFixed(0) })
process.exit(0)
